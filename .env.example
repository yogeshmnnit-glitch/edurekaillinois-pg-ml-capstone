# OpenAI
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Vector store
CHROMA_PERSIST_DIR=ChromaKnowledgeBaseDB

# Retrieval / RAG
TOP_K=8
CONFIDENCE_THRESHOLD=0.7

# Chunking
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# Uploads
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=pdf,txt,csv,xlsx,xls,docx,doc

# Chat history / retention
SQLITE_DB_PATH=Utility/storage/app_data.db
DEFAULT_RETENTION_DAYS=30
